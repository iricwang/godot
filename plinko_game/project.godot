; Plinko Game project — Enhanced Input (P10) demo.
; Opened with: godot --path plinko_game/

config_version=5

[application]

config/name="Plinko (EI Demo)"
config/description="P10 smoke test for the enhanced_input engine module."
run/main_scene="res://scenes/plinko_demo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

EISubsystem="*res://ei_autoload.gd"

[debug]

settings/stdout/print_fps=false

[input]

; Match Godot 4.7 InputMap defaults so the demo can run even on a fresh
; checkout that has never opened the editor. The EIBridge could import
; these into EIMappingContexts at runtime, but for the P10 demo we set
; up IMCs with explicit InputEventKey resources in the build script
; (build_demo_assets.gd) so the demo is self-contained.
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
